#!/bin/bash

# Pre-push hook for BlackBolt Operator
# Validates code before pushing to remote
# Bypass with: git push --no-verify

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}Running pre-push checks...${NC}"

# Check for uncommitted changes
echo "Checking for uncommitted changes..."
if [ -n "$(git status --porcelain)" ]; then
  echo -e "${RED}✗ You have uncommitted changes!${NC}"
  git status
  exit 1
fi
echo -e "${GREEN}✓ All changes committed${NC}"

# Validate branch naming
BRANCH=$(git rev-parse --abbrev-ref HEAD)
echo "Current branch: $BRANCH"

# Check if it's a valid branch name (no spaces, special chars except -)
if [[ ! "$BRANCH" =~ ^[a-zA-Z0-9/_-]+$ ]]; then
  echo -e "${RED}✗ Invalid branch name: $BRANCH${NC}"
  echo "Branch names should only contain alphanumeric characters, slashes, hyphens, and underscores"
  exit 1
fi

# Prevent accidental force pushes to main/master
if [[ "$BRANCH" == "main" || "$BRANCH" == "master" ]]; then
  echo -e "${YELLOW}⚠ You are about to push to '$BRANCH' branch${NC}"
  echo "Are you sure? (This action is logged)"
fi

# Check for force push attempts
if git rev-parse --verify HEAD &> /dev/null; then
  MERGE_BASE=$(git merge-base HEAD "@{u}" 2>/dev/null || echo "")
  if [ -n "$MERGE_BASE" ]; then
    if ! git log --oneline "$MERGE_BASE"..HEAD | grep -q .; then
      echo -e "${YELLOW}⚠ Attempting to rewrite history on remote branch${NC}"
      echo "Use 'git push --force' if this is intentional and you know the implications"
    fi
  fi
fi

# Run basic tests if test script exists
if [ -f "$REPO_ROOT/scripts/run-tests.sh" ]; then
  echo "Running tests..."
  if bash "$REPO_ROOT/scripts/run-tests.sh"; then
    echo -e "${GREEN}✓ Tests passed${NC}"
  else
    echo -e "${RED}✗ Tests failed${NC}"
    exit 1
  fi
fi

# Run quality checks if script exists
if [ -f "$REPO_ROOT/scripts/check-code-quality.sh" ]; then
  echo "Running code quality checks..."
  if bash "$REPO_ROOT/scripts/check-code-quality.sh"; then
    echo -e "${GREEN}✓ Code quality checks passed${NC}"
  else
    echo -e "${RED}✗ Code quality checks failed${NC}"
    exit 1
  fi
fi

echo -e "${GREEN}✓ All pre-push checks passed${NC}"
echo -e "${BLUE}Ready to push to $BRANCH${NC}"
exit 0
