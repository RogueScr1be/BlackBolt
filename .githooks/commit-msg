#!/bin/bash

# Commit-msg hook for BlackBolt Operator
# Validates commit message format against conventional commits spec
# Types: feat, fix, docs, style, refactor, test, chore, security

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Extract first line
FIRST_LINE=$(head -n1 "$COMMIT_MSG_FILE")

# Validation rules
MIN_LENGTH=10
MAX_FIRST_LINE=100

# Check minimum length
if [ ${#FIRST_LINE} -lt $MIN_LENGTH ]; then
  echo -e "${RED}✗ Commit message is too short (${#FIRST_LINE} chars, minimum: $MIN_LENGTH)${NC}"
  exit 1
fi

# Check maximum first line length
if [ ${#FIRST_LINE} -gt $MAX_FIRST_LINE ]; then
  echo -e "${RED}✗ First line is too long (${#FIRST_LINE} chars, maximum: $MAX_FIRST_LINE)${NC}"
  exit 1
fi

# Check conventional commit format
# Pattern: type(scope): message or type: message
if [[ ! "$FIRST_LINE" =~ ^(feat|fix|docs|style|refactor|test|chore|security)(\([a-z0-9\-]+\))?:[[:space:]] ]]; then
  echo -e "${RED}✗ Commit message does not follow conventional commits format${NC}"
  echo ""
  echo "Expected format: type(scope): message"
  echo "Types: feat, fix, docs, style, refactor, test, chore, security"
  echo ""
  echo "Examples:"
  echo "  feat: add new authentication flow"
  echo "  fix(security): remove hardcoded credentials"
  echo "  docs(setup): update installation instructions"
  exit 1
fi

# Check that message is capitalized after colon
if [[ "$FIRST_LINE" =~ :[[:space:]][a-z] ]]; then
  echo -e "${YELLOW}⚠ Message should start with capital letter after colon${NC}"
  echo "  Found: $FIRST_LINE"
  echo "  Expected first letter to be capitalized"
  # This is a warning, not an error, so we don't exit 1
fi

# Check for common issues
if grep -q "^WIP" "$COMMIT_MSG_FILE"; then
  echo -e "${YELLOW}⚠ WIP commit detected. Please use proper commit message.${NC}"
fi

echo -e "${GREEN}✓ Commit message is valid${NC}"
exit 0
