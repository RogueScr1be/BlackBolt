#!/bin/bash

# Pre-commit hook for BlackBolt Operator
# Validates code quality before allowing commits
# Bypass with: git commit --no-verify

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
SWIFT_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.swift$' || true)

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "Running pre-commit checks..."

# Check if there are any Swift files to validate
if [ -z "$SWIFT_FILES" ]; then
  echo -e "${GREEN}✓ No Swift files to validate${NC}"
else
  echo -e "${YELLOW}Found $(echo "$SWIFT_FILES" | wc -l) Swift file(s) to validate${NC}"

  # Run SwiftLint
  echo "Running SwiftLint..."
  if command -v swiftlint &> /dev/null; then
    if echo "$SWIFT_FILES" | xargs swiftlint lint --strict --config "$REPO_ROOT/.swiftlint.yml"; then
      echo -e "${GREEN}✓ SwiftLint passed${NC}"
    else
      echo -e "${RED}✗ SwiftLint failed. Run 'swiftlint --fix' to auto-fix issues.${NC}"
      exit 1
    fi
  else
    echo -e "${YELLOW}⚠ SwiftLint not installed. Skipping.${NC}"
  fi

  # Run SwiftFormat (check mode - do not modify files)
  echo "Running SwiftFormat (check mode)..."
  if command -v swiftformat &> /dev/null; then
    if echo "$SWIFT_FILES" | xargs swiftformat --lint --config "$REPO_ROOT/.swiftformat"; then
      echo -e "${GREEN}✓ SwiftFormat passed${NC}"
    else
      echo -e "${RED}✗ SwiftFormat found formatting issues.${NC}"
      echo "Run 'swiftformat --config .swiftformat .' to auto-format."
      exit 1
    fi
  else
    echo -e "${YELLOW}⚠ SwiftFormat not installed. Skipping.${NC}"
  fi
fi

# Run git-secrets to detect credentials
echo "Running git-secrets check..."
if command -v git-secrets &> /dev/null; then
  if git secrets scan-history 2>/dev/null || git secrets scan --cached 2>/dev/null; then
    echo -e "${GREEN}✓ No secrets detected${NC}"
  else
    echo -e "${RED}✗ Potential secrets detected!${NC}"
    exit 1
  fi
else
  echo -e "${YELLOW}⚠ git-secrets not installed. Skipping.${NC}"
fi

# Check file size to prevent large files
echo "Checking file sizes..."
MAX_SIZE=1000  # KB
for file in $(git diff --cached --name-only --diff-filter=A | grep -v \.git/); do
  if [ -f "$file" ]; then
    SIZE=$(du -k "$file" | cut -f1)
    if [ "$SIZE" -gt "$MAX_SIZE" ]; then
      echo -e "${RED}✗ File '$file' is too large ($SIZE KB, max: $MAX_SIZE KB)${NC}"
      exit 1
    fi
  fi
done
echo -e "${GREEN}✓ File sizes OK${NC}"

# Validate configuration files
echo "Validating configuration files..."
if [ -f "$REPO_ROOT/.swiftlint.yml" ]; then
  if command -v yamllint &> /dev/null; then
    if yamllint "$REPO_ROOT/.swiftlint.yml"; then
      echo -e "${GREEN}✓ .swiftlint.yml is valid${NC}"
    else
      echo -e "${YELLOW}⚠ .swiftlint.yml validation failed${NC}"
    fi
  fi
fi

echo -e "${GREEN}✓ All pre-commit checks passed${NC}"
exit 0
