NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://<user>:<pass>@<host>:<port>/<db>
REDIS_URL=redis://<user>:<pass>@<host>:<port>

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SOS tenant routing
TENANT_ID=<sos-tenant-id>

# Follow-up email provider
SOS_GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
SOS_GMAIL_DELEGATED_USER=leah@soslactation.com
SOS_GMAIL_FROM_EMAIL=leah@soslactation.com

# Provider fax (baseline: SRFax, pilot: ICTFax)
SOS_FAX_PROVIDER=srfax
# SRFax baseline
SOS_SRFAX_BASE_URL=https://www.srfax.com/SRF_SecWebSvc.php
SOS_SRFAX_ACCOUNT_ID=<account-id>
SOS_SRFAX_PASSWORD=<password>
SOS_SRFAX_SENDER_NUMBER=<sender-number>
# ICTFax pilot
# SOS_ICTFAX_BASE_URL=https://ictfax.example.com
# SOS_ICTFAX_API_USER=<api-user>
# SOS_ICTFAX_API_PASSWORD=<api-password>
# Optional
# SOS_ICTFAX_ACCOUNT_ID=<numeric-account-id>
# SOS_ICTFAX_CONTACT_NAME_PREFIX=SOS

# Optional monitor webhook for failure notifications
SOS_MONITOR_WEBHOOK_URL=
